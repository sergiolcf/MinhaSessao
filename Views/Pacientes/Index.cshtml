@model MinhaSessao.Models.ViewModels.PacientesIndexViewModel
@{
    ViewData["Title"] = "Meus Pacientes";
    Layout = "_LayoutDashboard";
}

<div class="ms-dash-page-header">
    <div>
        <h1 class="ms-dash-welcome-title">Meus Pacientes</h1>
        <p class="ms-dash-welcome-subtitle mb-0">Gerencie os pacientes vinculados ao seu atendimento.</p>
    </div>
    <button type="button" class="btn btn-ms-orange" data-bs-toggle="modal" data-bs-target="#modalCadastroPaciente">
        <i class="bi bi-plus-lg"></i> Novo Paciente
    </button>
</div>

@if (Model.Pacientes.Count == 0 && Model.TotalPaginas <= 1)
{
    <div class="ms-dash-empty-state">
        <i class="bi bi-people"></i>
        <h5>Nenhum paciente cadastrado ainda</h5>
        <p>Clique em "Novo Paciente" para cadastrar o primeiro paciente da sua agenda.</p>
    </div>
}
else
{
    <div class="ms-anotacao-toolbar mb-3">
        <div class="ms-anotacao-search">
            <i class="bi bi-search"></i>
            <input type="text" id="filtroPacienteBusca" class="form-control form-control-sm" placeholder="Buscar paciente por nome ou CPF..." autocomplete="off">
        </div>
    </div>

    <div class="ms-dash-card ms-dash-table-card" id="cardPacientes"
         data-pagina-atual="@Model.PaginaAtual" data-total-paginas="@Model.TotalPaginas">
        <div class="table-responsive ms-dash-table-scroll-pacientes">
            <table class="table table-hover ms-dash-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nome Completo</th>
                        <th>Contato</th>
                        <th>Data de Nascimento</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody id="tbodyPacientes">
                    @foreach (var paciente in Model.Pacientes)
                    {
                        <partial name="_LinhaPaciente" model="paciente" />
                    }
                </tbody>
            </table>
        </div>
    </div>
    <nav aria-label="Paginação de pacientes" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center ms-pagination" id="paginacaoPacientes">
            @if (Model.TotalPaginas > 1)
            {
                for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                {
                    <li class="page-item@(pagina == Model.PaginaAtual ? " active" : "")">
                        <button type="button" class="page-link" data-pagina="@pagina">@pagina</button>
                    </li>
                }
            }
        </ul>
    </nav>
}

<!-- Modal: Novo Paciente (fluxo em 2 passos: verificar e-mail antes de cadastrar) -->
<div class="modal fade" id="modalCadastroPaciente" tabindex="-1" aria-labelledby="modalCadastroPacienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalCadastroPacienteLabel">Novo Paciente</h5>
                    <p class="ms-modal-subtitle mb-0">Informe o CPF do paciente para começar</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @* Token único, reaproveitado pelos POSTs de Vincular e Criar *@
                @Html.AntiForgeryToken()

                <!-- Etapa 1: Verificar CPF -->
                <div id="etapaVerificarCpf">
                    <div id="verificarCpfFeedbackErro" class="ms-alert ms-alert-erro d-none" role="alert">
                        <i class="bi bi-x-circle-fill"></i>
                        <div>
                            <strong>Erro</strong>
                            <p class="mb-0" id="verificarCpfFeedbackErroMensagem"></p>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="verificarCpfInput" class="form-label">CPF do Paciente<span class="ms-required">*</span></label>
                        <input type="text" id="verificarCpfInput" class="form-control" placeholder="000.000.000-00" inputmode="numeric" maxlength="14">
                    </div>
                </div>

                <!-- Etapa 2: Paciente já cadastrado, só falta vincular -->
                <div id="etapaPacienteEncontrado" class="d-none text-center py-3">
                    <span class="ms-avatar-iniciais ms-avatar-iniciais-lg mb-3" id="pacienteEncontradoIniciais"></span>
                    <h5 class="mb-1" id="pacienteEncontradoNome"></h5>
                    <p class="ms-dash-table-subtext mb-3">Encontramos um paciente cadastrado com esse CPF. Deseja adicioná-lo à sua lista de pacientes?</p>
                    <button type="button" class="btn btn-link btn-sm p-0" id="btnVerificarOutroCpf">Não é esse paciente? Verificar outro CPF</button>
                </div>

                <!-- Etapa 3: Cadastro completo (e-mail ainda não existe) -->
                <div id="cadastroPacienteFeedbackErro" class="ms-alert ms-alert-erro d-none" role="alert">
                    <i class="bi bi-x-circle-fill"></i>
                    <div>
                        <strong>Erro ao Cadastrar</strong>
                        <p class="mb-0" id="cadastroPacienteFeedbackErroMensagem"></p>
                    </div>
                </div>
                <form id="formCadastroPaciente" class="d-none">
                    <div class="mb-3">
                        <label for="PacienteNomeCompleto" class="form-label">Nome Completo<span class="ms-required">*</span></label>
                        <input type="text" id="PacienteNomeCompleto" name="NomeCompleto" class="form-control" placeholder="Nome completo do paciente">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="PacienteTelefone" class="form-label">Telefone<span class="ms-required">*</span></label>
                            <input type="tel" id="PacienteTelefone" name="Telefone" class="form-control" placeholder="(00) 00000-0000">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="PacienteEmail" class="form-label">E-mail<span class="ms-required">*</span></label>
                            <input type="email" id="PacienteEmail" name="Email" class="form-control" placeholder="paciente@email.com">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="PacienteDataNascimento" class="form-label">Data de Nascimento<span class="ms-required">*</span></label>
                            <input type="date" id="PacienteDataNascimento" name="DataNascimento" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="PacienteCpf" class="form-label">CPF<span class="ms-required">*</span></label>
                            <input type="text" id="PacienteCpf" name="Cpf" class="form-control" readonly>
                            <button type="button" class="btn btn-link btn-sm p-0 mt-1" id="btnTrocarCpf">trocar CPF</button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="PacienteSexo" class="form-label">Sexo</label>
                            <select id="PacienteSexo" name="Sexo" class="form-select">
                                <option value="">Selecione</option>
                                <option value="Feminino">Feminino</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Outro">Outro</option>
                                <option value="Prefiro não informar">Prefiro não informar</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="PacienteContatoEmergencia" class="form-label">Contato de Emergência</label>
                            <input type="text" id="PacienteContatoEmergencia" name="ContatoEmergencia" class="form-control" placeholder="Nome e telefone">
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="PacienteProfissao" class="form-label">Profissão</label>
                        <input type="text" id="PacienteProfissao" name="Profissao" class="form-control" placeholder="Profissão do paciente">
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-ms-orange" id="btnVerificarCpf">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="btnVerificarCpfSpinner"></span>
                    <span id="btnVerificarCpfTexto">Verificar</span>
                </button>
                <button type="button" class="btn btn-ms-orange d-none" id="btnVincularPaciente">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="btnVincularPacienteSpinner"></span>
                    <span id="btnVincularPacienteTexto">Vincular este paciente</span>
                </button>
                <button type="submit" form="formCadastroPaciente" class="btn btn-ms-orange d-none" id="btnSalvarPaciente">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="btnSalvarPacienteSpinner"></span>
                    <span id="btnSalvarPacienteTexto">Salvar Paciente</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pacientes.js" asp-append-version="true"></script>
}
