@model MinhaSessao.Models.ViewModels.PacienteDetalhesViewModel
@{
    ViewData["Title"] = Model.NomeCompleto;
    Layout = "_LayoutDashboard";
}

<a asp-action="Index" class="btn btn-light border shadow-sm btn-sm ms-dash-back-link mb-3">
    <i class="bi bi-arrow-left me-1"></i> Voltar para Pacientes
</a>

<div class="ms-dash-detail-header">
    <div class="ms-dash-detail-identity">
        <span class="ms-avatar-iniciais ms-avatar-iniciais-lg">@Model.Iniciais</span>
        <div>
            <h1 class="ms-dash-detail-title">
                @Model.NomeCompleto
                @if (Model.Ativo)
                {
                    <span class="badge ms-badge-ativo">Ativo</span>
                }
                else
                {
                    <span class="badge ms-badge-inativo">Inativo</span>
                }
            </h1>
            <p class="ms-dash-welcome-subtitle mb-0">@Model.Idade anos &middot; Paciente desde @Model.DataCadastro.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
    <div class="ms-dash-detail-shortcuts">
        <a href="tel:@Model.Telefone" class="btn btn-sm ms-dash-btn-icon" title="Ligar para o paciente">
            <i class="bi bi-telephone"></i>
        </a>
        <a href="mailto:@Model.Email" class="btn btn-sm ms-dash-btn-icon" title="Enviar e-mail">
            <i class="bi bi-envelope"></i>
        </a>
        <button type="button" class="btn btn-sm ms-dash-btn-icon" title="Em breve" disabled>
            <i class="bi bi-calendar-plus"></i>
        </button>
    </div>
</div>

<ul class="nav nav-tabs ms-dash-tabs" id="pacienteTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="prontuario-tab" data-bs-toggle="tab" data-bs-target="#prontuario" type="button" role="tab" aria-controls="prontuario" aria-selected="true">
            <i class="bi bi-shield-lock me-1"></i> Anotações Confidenciais
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="sessoes-tab" data-bs-toggle="tab" data-bs-target="#sessoes" type="button" role="tab" aria-controls="sessoes" aria-selected="false">
            <i class="bi bi-clock-history me-1"></i> Histórico de Sessões
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="false">
            <i class="bi bi-person-vcard me-1"></i> Dados Cadastrais
        </button>
    </li>
</ul>

<div class="tab-content ms-dash-tab-content" id="pacienteTabsContent">
    <div class="tab-pane fade show active" id="prontuario" role="tabpanel" aria-labelledby="prontuario-tab">
        <div class="ms-dash-page-header ms-anotacao-tab-header">
            <div>
                <h5 class="mb-1">Anotações Confidenciais</h5>
                <p class="ms-dash-table-subtext mb-0">Registros visíveis apenas para você.</p>
            </div>
            <div class="ms-anotacao-toolbar">
                <div class="ms-anotacao-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="buscaAnotacaoTitulo" class="form-control form-control-sm" placeholder="Buscar por título..." autocomplete="off" list="sugestoesTituloAnotacao">
                    <datalist id="sugestoesTituloAnotacao"></datalist>
                </div>
                <select id="ordenacaoAnotacoes" class="form-select form-select-sm ms-anotacao-ordenacao" title="Ordenar por data">
                    <option value="recente" selected>Mais novo</option>
                    <option value="antigo">Mais antigo</option>
                </select>
                <button type="button" class="btn btn-ms-orange" data-bs-toggle="modal" data-bs-target="#modalNovaAnotacao">
                    <i class="bi bi-plus-lg"></i> Nova Anotação
                </button>
            </div>
        </div>

        <div id="anotacoesContainer"
             data-paciente-id="@Model.Id"
             data-pagina-atual="@Model.PaginaAtualAnotacoes"
             data-total-paginas="@Model.TotalPaginasAnotacoes">
            <div class="ms-timeline-scroll">
                <div class="ms-timeline" id="listaAnotacoes">
                    @if (Model.Anotacoes.Count == 0)
                    {
                        <div class="ms-dash-empty-state" id="anotacoesEmptyState">
                            <i class="bi bi-journal-lock"></i>
                            <h5>Nenhuma anotação registrada</h5>
                            <p>Clique em "Nova Anotação" para registrar a primeira anotação confidencial sobre @Model.NomeCompleto.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var anotacao in Model.Anotacoes)
                        {
                            <div class="ms-timeline-item" data-anotacao-id="@anotacao.Id">
                                <span class="ms-timeline-marker"></span>
                                <div class="ms-timeline-content">
                                    <div class="ms-timeline-header">
                                        <strong class="ms-timeline-title">@(string.IsNullOrWhiteSpace(anotacao.Titulo) ? "Anotação" : anotacao.Titulo)</strong>
                                        <div class="ms-timeline-actions">
                                            <span class="ms-timeline-date">@anotacao.DataRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                                            <button type="button" class="ms-timeline-edit" data-anotacao-id="@anotacao.Id" data-titulo="@anotacao.Titulo" data-conteudo="@anotacao.Conteudo" title="Editar anotação">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="ms-timeline-delete" data-anotacao-id="@anotacao.Id" title="Excluir anotação">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="ms-timeline-body">@anotacao.Conteudo</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <nav aria-label="Paginação de anotações" class="mt-3">
                <ul class="pagination pagination-sm justify-content-center" id="paginacaoAnotacoes">
                    @if (Model.TotalPaginasAnotacoes > 1)
                    {
                        for (var pagina = 1; pagina <= Model.TotalPaginasAnotacoes; pagina++)
                        {
                            <li class="page-item@(pagina == Model.PaginaAtualAnotacoes ? " active" : "")">
                                <button type="button" class="page-link" data-pagina="@pagina">@pagina</button>
                            </li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>
    <div class="tab-pane fade" id="sessoes" role="tabpanel" aria-labelledby="sessoes-tab">
        <div class="ms-dash-empty-state">
            <i class="bi bi-clock-history"></i>
            <h5>Histórico de Sessões</h5>
            <p>Em breve você poderá acompanhar aqui as sessões realizadas com @Model.NomeCompleto.</p>
        </div>
    </div>
    <div class="tab-pane fade" id="dados" role="tabpanel" aria-labelledby="dados-tab">
        <div class="ms-dash-card">
            <div class="ms-dash-card-header">
                <h5 class="mb-0">Dados Cadastrais</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Em breve" disabled>
                    <i class="bi bi-pencil"></i> Editar
                </button>
            </div>
            <div class="ms-dash-info-grid">
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">Telefone</span>
                    <span class="ms-dash-info-value">@Model.Telefone</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">E-mail</span>
                    <span class="ms-dash-info-value">@Model.Email</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">Data de Nascimento</span>
                    <span class="ms-dash-info-value">@Model.DataNascimento.ToString("dd/MM/yyyy") (@Model.Idade anos)</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">CPF</span>
                    <span class="ms-dash-info-value">@(string.IsNullOrWhiteSpace(Model.Cpf) ? "Não informado" : Model.Cpf)</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">Sexo</span>
                    <span class="ms-dash-info-value">@(string.IsNullOrWhiteSpace(Model.Sexo) ? "Não informado" : Model.Sexo)</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">Profissão</span>
                    <span class="ms-dash-info-value">@(string.IsNullOrWhiteSpace(Model.Profissao) ? "Não informado" : Model.Profissao)</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">Contato de Emergência</span>
                    <span class="ms-dash-info-value">@(string.IsNullOrWhiteSpace(Model.ContatoEmergencia) ? "Não informado" : Model.ContatoEmergencia)</span>
                </div>
                <div class="ms-dash-info-item">
                    <span class="ms-dash-info-label">Cadastrado em</span>
                    <span class="ms-dash-info-value">@Model.DataCadastro.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="ms-dash-card mt-3">
            <div class="ms-dash-card-header">
                <h5 class="mb-0">Acesso do Paciente</h5>
            </div>
            <p class="ms-dash-table-subtext mb-3">Caso o paciente perca a senha temporária de acesso, gere uma nova a qualquer momento.</p>
            <div id="tokenGerarNovaSenhaPaciente">@Html.AntiForgeryToken()</div>
            <button type="button" class="btn btn-outline-secondary" id="btnGerarNovaSenhaPaciente" data-paciente-id="@Model.Id">
                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="btnGerarNovaSenhaPacienteSpinner"></span>
                <i class="bi bi-key" id="btnGerarNovaSenhaPacienteIcone"></i>
                <span id="btnGerarNovaSenhaPacienteTexto">Gerar nova senha</span>
            </button>
        </div>
    </div>
</div>

<!-- Modal: Nova Anotação Confidencial -->
<div class="modal fade" id="modalNovaAnotacao" tabindex="-1" aria-labelledby="modalNovaAnotacaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNovaAnotacaoLabel">
                    <i class="bi bi-incognito me-2"></i><span id="modalNovaAnotacaoTitulo">Nova Anotação Confidencial</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="anotacaoFeedbackErro" class="ms-alert ms-alert-erro d-none" role="alert">
                    <i class="bi bi-x-circle-fill"></i>
                    <div>
                        <strong>Erro ao Salvar</strong>
                        <p class="mb-0" id="anotacaoFeedbackErroMensagem"></p>
                    </div>
                </div>

                <form id="formAnotacaoConfidencial">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="anotacaoId" name="Id" value="" />
                    <input type="hidden" name="PacienteId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="anotacaoTitulo" class="form-label">Título</label>
                        <input type="text" id="anotacaoTitulo" name="Titulo" class="form-control" placeholder="Ex.: Sessão de acompanhamento, Observação inicial...">
                    </div>
                    <div class="mb-2">
                        <label for="anotacaoConteudo" class="form-label">Conteúdo<span class="ms-required">*</span></label>
                        <textarea id="anotacaoConteudo" name="Conteudo" class="form-control" rows="5" placeholder="Escreva aqui suas observações confidenciais sobre o paciente..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formAnotacaoConfidencial" class="btn btn-ms-orange" id="btnSalvarAnotacao">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="btnSalvarAnotacaoSpinner"></span>
                    <span id="btnSalvarAnotacaoTexto">Salvar Anotação</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/anotacoes.js" asp-append-version="true"></script>
    <script src="~/js/pacientes-detalhes.js" asp-append-version="true"></script>
}
