<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MinhaSessao</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="ms-dashboard-body">
    <nav class="ms-dash-navbar">
        <div class="ms-dash-navbar-left">
            <button type="button" class="ms-sidebar-toggle" id="sidebarToggle" aria-label="Alternar menu" aria-expanded="true">
                <i class="bi bi-list"></i>
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="ms-dash-brand">
                <i class="bi bi-house-door-fill"></i>
                <span><span class="ms-brand-primary-dark">Minha</span><span class="ms-brand-accent">Sessao</span></span>
            </a>
            <partial name="_BadgeAlfa" />
        </div>
        <div class="ms-dash-navbar-center">
            <span>Painel do Profissional</span>
        </div>
        <div class="ms-dash-navbar-right">
            @{
                var fotoUrl = ViewBag.ProfissionalFotoUrl as string;
                var nomeProfissional = ViewBag.ProfissionalNome as string ?? string.Empty;
            }
            @if (!string.IsNullOrWhiteSpace(fotoUrl))
            {
                <img src="@fotoUrl" alt="Foto de @nomeProfissional" class="ms-dash-avatar" />
            }
            else
            {
                <span class="ms-dash-avatar ms-dash-avatar-placeholder" aria-hidden="true">
                    <i class="bi bi-person-fill"></i>
                </span>
            }
            <span class="ms-dash-user-name">@nomeProfissional</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="ms-dash-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="ms-dash-logout-btn" title="Sair">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>
    </nav>

    <div class="ms-dash-body">
        @{
            var controladorAtual = ViewContext.RouteData.Values["controller"]?.ToString();
            var acaoAtual = ViewContext.RouteData.Values["action"]?.ToString();
            var isInicioAtivo = string.Equals(controladorAtual, "Dashboard", StringComparison.OrdinalIgnoreCase)
                && string.Equals(acaoAtual, "Index", StringComparison.OrdinalIgnoreCase);
            var isPacientesAtivo = string.Equals(controladorAtual, "Pacientes", StringComparison.OrdinalIgnoreCase);
        }
        <aside class="ms-dash-sidebar" id="dashSidebar">
            <ul class="ms-dash-menu">
                <li>
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="ms-dash-menu-link@(isInicioAtivo ? " active" : "")">
                        <i class="bi bi-grid-1x2"></i>
                        <span class="menu-text">Início</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="ms-dash-menu-link">
                        <i class="bi bi-calendar-check"></i>
                        <span class="menu-text">Minha Agenda</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Pacientes" asp-action="Index"
                       class="ms-dash-menu-link@(isPacientesAtivo ? " active" : "")">
                        <i class="bi bi-people"></i>
                        <span class="menu-text">Meus Pacientes</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="ms-dash-menu-link">
                        <i class="bi bi-journal-medical"></i>
                        <span class="menu-text">Minhas Sessões</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="ms-dash-menu-link">
                        <i class="bi bi-gear"></i>
                        <span class="menu-text">Configurações</span>
                    </a>
                </li>
            </ul>
        </aside>

        <main class="ms-dash-main">
            @RenderBody()

            <footer class="ms-copyright-footer">
                <div class="ms-copyright-footer-inner">
                    <span class="ms-copyright-footer-lgpd">Ambiente seguro em conformidade com a LGPD.</span>
                    <span class="ms-copyright-footer-copyright">&copy; 2026 MinhaSessao. Todos os direitos reservados.</span>
                </div>
            </footer>
        </main>
    </div>

    <!-- Modal: Senha Temporária (reutilizado no cadastro e na regeneração de senha do paciente) -->
    <div class="modal fade" id="modalSenhaTemporaria" tabindex="-1" aria-labelledby="modalSenhaTemporariaLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalSenhaTemporariaLabel">
                        <i class="bi bi-key-fill me-2"></i>Senha Temporária Gerada
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="ms-dash-table-subtext">Copie e repasse esta senha ao paciente. Por segurança, ela não poderá ser exibida novamente — se perdê-la, gere uma nova.</p>
                    <div class="ms-senha-temp-box">
                        <input type="text" id="senhaTemporariaValor" class="form-control" readonly>
                        <button type="button" class="btn ms-dash-btn-icon" id="btnCopiarSenhaTemporaria" title="Copiar senha">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                    <p class="ms-senha-temp-copiado d-none" id="senhaTemporariaCopiadoMsg">
                        <i class="bi bi-check-circle-fill"></i> Senha copiada!
                    </p>
                </div>
                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-ms-orange" data-bs-dismiss="modal">Concluído</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
