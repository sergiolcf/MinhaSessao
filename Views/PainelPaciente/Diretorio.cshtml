@model MinhaSessao.Models.ViewModels.DiretorioViewModel
@{
    ViewData["Title"] = "Diretório de Profissionais";
    Layout = "_LayoutDashboardPaciente";
}

<div class="ms-dash-page-header">
    <div>
        <h1 class="ms-dash-welcome-title">Diretório de Profissionais</h1>
        <p class="ms-dash-welcome-subtitle mb-0">Encontre um profissional e entre em contato diretamente.</p>
    </div>
</div>

<form method="get" asp-controller="PainelPaciente" asp-action="Diretorio" class="ms-diretorio-busca mb-4">
    <div class="input-group">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="busca" value="@Model.TermoBusca" class="form-control" placeholder="Buscar por nome ou CRP...">
        <button type="submit" class="btn btn-ms-orange">Buscar</button>
    </div>
</form>

@if (Model.Profissionais.Count == 0)
{
    <div class="ms-dash-empty-state">
        <i class="bi bi-search"></i>
        <h5>Nenhum profissional encontrado</h5>
        <p>Tente buscar por outro nome ou CRP.</p>
    </div>
}
else
{
    <div class="ms-diretorio-grid">
        @foreach (var profissional in Model.Profissionais)
        {
            <div class="ms-dash-card ms-diretorio-card">
                @if (!string.IsNullOrWhiteSpace(profissional.FotoUrl))
                {
                    <img src="@profissional.FotoUrl" alt="Foto de @profissional.NomeCompleto" class="ms-diretorio-avatar">
                }
                else
                {
                    <span class="ms-avatar-iniciais ms-avatar-iniciais-lg mb-2">@MinhaSessao.Models.ViewModels.PacienteIniciais.Calcular(profissional.NomeCompleto)</span>
                }
                <h5 class="mb-1">@profissional.NomeCompleto</h5>
                <p class="ms-dash-table-subtext mb-0">@profissional.RegistroCRP</p>
                @if (!string.IsNullOrWhiteSpace(profissional.Apresentacao))
                {
                    <p class="ms-diretorio-apresentacao">@profissional.Apresentacao</p>
                }
                <div class="ms-diretorio-actions">
                    <a href="tel:@profissional.Telefone" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-telephone"></i> Ligar
                    </a>
                    <a href="https://wa.me/@profissional.TelefoneWhatsApp" target="_blank" rel="noopener" class="btn btn-sm btn-ms-orange">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </a>
                </div>
            </div>
        }
    </div>
}
