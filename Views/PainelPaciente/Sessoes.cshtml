@model MinhaSessao.Models.ViewModels.PainelSessoesViewModel
@{
    ViewData["Title"] = "Minhas Sessões";
    Layout = "_LayoutDashboardPaciente";
}

<div class="ms-dash-page-header">
    <div>
        <h1 class="ms-dash-welcome-title">Minhas Sessões</h1>
        <p class="ms-dash-welcome-subtitle mb-0">Acompanhe suas sessões agendadas e o histórico de atendimentos.</p>
    </div>
</div>

<!-- 4 cards cobrindo os status de sessão existentes (Agendada/Realizada/Cancelada) + a Próxima Sessão
     em destaque no meio — .ms-dash-cards já acomoda os 4 automaticamente (grid-template-columns:
     repeat(auto-fit, minmax(220px, 1fr))), sem precisar de CSS novo -->
<div class="ms-dash-cards mb-4">
    <div class="ms-dash-card">
        <i class="bi bi-calendar-check"></i>
        <h5>Agendadas</h5>
        <p class="ms-stat-numero mb-0">@Model.TotalAgendadas</p>
    </div>
    <div class="ms-dash-card">
        <i class="bi bi-calendar-event"></i>
        <h5>Próxima Sessão</h5>
        @if (Model.ProximaSessao is not null)
        {
            <p class="ms-stat-numero mb-0">@Model.ProximaSessao.DataHora.ToString("dd/MM/yyyy") às @Model.ProximaSessao.DataHora.ToString("HH:mm")</p>
            <p class="mb-0">com @Model.ProximaSessao.ProfissionalNome</p>
        }
        else
        {
            <p class="mb-0">Nenhuma sessão agendada no momento.</p>
        }
    </div>
    <div class="ms-dash-card">
        <i class="bi bi-x-circle"></i>
        <h5>Canceladas</h5>
        <p class="ms-stat-numero mb-0">@Model.TotalCanceladas</p>
    </div>
    <div class="ms-dash-card">
        <i class="bi bi-check2-circle"></i>
        <h5>Realizadas</h5>
        <p class="ms-stat-numero mb-0">@Model.TotalRealizadas</p>
    </div>
</div>

<ul class="nav nav-tabs ms-dash-tabs" id="sessoesTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="agendadas-tab" data-bs-toggle="tab" data-bs-target="#agendadasSessoes" type="button" role="tab" aria-controls="agendadasSessoes" aria-selected="true">
            <i class="bi bi-calendar-week"></i> Agendadas
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="historico-tab" data-bs-toggle="tab" data-bs-target="#historicoSessoes" type="button" role="tab" aria-controls="historicoSessoes" aria-selected="false">
            <i class="bi bi-clock-history"></i> Histórico
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="anotacoes-clinicas-tab" data-bs-toggle="tab" data-bs-target="#anotacoesClinicasSessoes" type="button" role="tab" aria-controls="anotacoesClinicasSessoes" aria-selected="false">
            <i class="bi bi-journal-text"></i> Anotações Clínicas
        </button>
    </li>
</ul>

<div class="tab-content ms-dash-tab-content" id="sessoesTabsContent">
    <div class="tab-pane fade show active" id="agendadasSessoes" role="tabpanel" aria-labelledby="agendadas-tab">
        @if (Model.Agendadas.Count == 0)
        {
            <div class="ms-dash-empty-state">
                <i class="bi bi-calendar-week"></i>
                <h5>Nenhuma sessão agendada</h5>
                <p>Quando um profissional agendar uma sessão com você, ela aparecerá aqui.</p>
            </div>
        }
        else
        {
            <div class="ms-dash-card ms-dash-table-card">
                <div class="table-responsive">
                    <table class="table table-hover ms-dash-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Hora</th>
                                <th>Profissional Responsável</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sessao in Model.Agendadas)
                            {
                                <partial name="_LinhaSessao" model="sessao" />
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="tab-pane fade" id="historicoSessoes" role="tabpanel" aria-labelledby="historico-tab">
        @if (Model.Historico.Count == 0)
        {
            <div class="ms-dash-empty-state">
                <i class="bi bi-clock-history"></i>
                <h5>Nenhum histórico ainda</h5>
                <p>Suas sessões realizadas ou canceladas aparecerão aqui.</p>
            </div>
        }
        else
        {
            <div class="ms-dash-card ms-dash-table-card">
                <div class="table-responsive">
                    <table class="table table-hover ms-dash-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Hora</th>
                                <th>Profissional Responsável</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sessao in Model.Historico)
                            {
                                <partial name="_LinhaSessao" model="sessao" />
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="tab-pane fade" id="anotacoesClinicasSessoes" role="tabpanel" aria-labelledby="anotacoes-clinicas-tab">
        <div class="ms-dash-page-header ms-anotacao-tab-header">
            <div>
                <h5 class="mb-1">Anotações Clínicas</h5>
                <p class="ms-dash-table-subtext mb-0">Todas as anotações clínicas registradas nas suas sessões, das mais recentes às mais antigas — somente leitura.</p>
            </div>
            <div class="ms-anotacao-toolbar">
                <div class="ms-anotacao-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="buscaAnotacaoClinicaTituloPaciente" class="form-control form-control-sm" placeholder="Buscar por título..." autocomplete="off">
                </div>
                <div class="ms-anotacao-periodo">
                    <input type="date" id="filtroAnotacaoClinicaDataInicio" class="form-control form-control-sm" title="Data início">
                    <span class="ms-anotacao-periodo-separador">até</span>
                    <input type="date" id="filtroAnotacaoClinicaDataFim" class="form-control form-control-sm" title="Data fim">
                    <button type="button" class="ms-anotacao-periodo-limpar d-none" id="btnLimparPeriodoAnotacaoClinica" title="Limpar período">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="anotacoesClinicasContainer"
             data-pagina-atual="@Model.PaginaAtualAnotacoesClinicas"
             data-total-paginas="@Model.TotalPaginasAnotacoesClinicas">
            <div class="ms-dash-card ms-dash-table-card">
                <div class="table-responsive ms-dash-table-scroll-anotacoes-clinicas">
                    <table class="table table-hover ms-dash-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Código da Sessão</th>
                                <th>Data</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="listaAnotacoesClinicas">
                            @if (Model.AnotacoesClinicas.Count == 0)
                            {
                                <tr id="anotacoesClinicasEmptyRow">
                                    <td colspan="4">
                                        <div class="ms-dash-empty-state">
                                            <i class="bi bi-journal-text"></i>
                                            <h5>Nenhuma anotação clínica registrada</h5>
                                            <p>As anotações clínicas registradas pelos seus profissionais em "Minhas Sessões" aparecerão aqui.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var anotacao in Model.AnotacoesClinicas)
                                {
                                    <tr data-anotacao-id="@anotacao.Id"
                                        data-titulo="@anotacao.Titulo"
                                        data-conteudo="@anotacao.Conteudo"
                                        data-data-registro="@anotacao.DataRegistro.ToString("dd/MM/yyyy HH:mm")">
                                        <td>
                                            @anotacao.Titulo
                                            @if (anotacao.Objetivos.Count > 0)
                                            {
                                                <div class="ms-objetivo-chips-wrapper mt-1">
                                                    @foreach (var objetivo in anotacao.Objetivos)
                                                    {
                                                        <span class="ms-objetivo-chip">@objetivo</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="ms-badge-codigo">@anotacao.SessaoCodigo</span>
                                            <div class="ms-dash-table-subtext">@anotacao.SessaoDataHora.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>@anotacao.DataRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <button type="button" class="ms-dash-row-link" title="Visualizar">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <nav aria-label="Paginação de anotações clínicas" class="mt-3">
                <ul class="pagination pagination-sm justify-content-center ms-pagination" id="paginacaoAnotacoesClinicas">
                    @if (Model.TotalPaginasAnotacoesClinicas > 1)
                    {
                        for (var pagina = 1; pagina <= Model.TotalPaginasAnotacoesClinicas; pagina++)
                        {
                            <li class="page-item@(pagina == Model.PaginaAtualAnotacoesClinicas ? " active" : "")">
                                <button type="button" class="page-link" data-pagina="@pagina">@pagina</button>
                            </li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Modal: Detalhes da Sessão (somente dados administrativos, sem prontuário/anotações — Anotações
     Clínicas viraram a aba dedicada "Anotações Clínicas" acima, no mesmo padrão da Ficha do
     Paciente do profissional; Anotações Confidenciais continuam exclusivas do profissional) -->
<div class="modal fade" id="modalDetalhesSessao" tabindex="-1" aria-labelledby="modalDetalhesSessaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalhesSessaoLabel">Detalhes da Sessão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="detalhesSessaoCarregando" class="text-center py-4">
                    <div class="spinner-border text-secondary" role="status" aria-hidden="true"></div>
                </div>
                <div id="detalhesSessaoConteudo" class="d-none">
                    <div class="mb-2"><strong>Data:</strong> <span id="detalhesSessaoData"></span></div>
                    <div class="mb-2"><strong>Hora:</strong> <span id="detalhesSessaoHora"></span></div>
                    <div class="mb-2"><strong>Profissional Responsável:</strong> <span id="detalhesSessaoProfissional"></span></div>
                    <div class="mb-0"><strong>Status:</strong> <span id="detalhesSessaoStatus"></span></div>
                </div>
                <div id="detalhesSessaoErro" class="ms-alert ms-alert-erro d-none" role="alert">
                    <i class="bi bi-x-circle-fill"></i>
                    <div>
                        <strong>Erro</strong>
                        <p class="mb-0">Não foi possível carregar os detalhes desta sessão.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Visualizar Anotação Clínica (somente leitura — sem nenhuma ação de editar/excluir, já
     que quem registra a evolução clínica é sempre o profissional, em Sessoes/Sessao) -->
<div class="modal fade" id="modalVisualizarAnotacaoClinica" tabindex="-1" aria-labelledby="modalVisualizarAnotacaoClinicaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalVisualizarAnotacaoClinicaLabel">
                    <span id="modalVisualizarAnotacaoClinicaTitulo"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="modalVisualizarAnotacaoClinicaObjetivosWrapper" class="mb-3">
                    <span class="ms-dash-info-label d-block mb-1">Objetivos Trabalhados</span>
                    <div class="ms-objetivo-chips-wrapper" id="modalVisualizarAnotacaoClinicaObjetivos"></div>
                </div>
                <div class="mb-2 ms-anotacao-sessao-item-data" id="modalVisualizarAnotacaoClinicaData"></div>
                <div id="modalVisualizarAnotacaoClinicaConteudo" style="white-space: pre-wrap;"></div>
            </div>
            <div class="modal-footer justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/painel-sessoes.js" asp-append-version="true"></script>
    <script src="~/js/painel-anotacoes-clinicas.js" asp-append-version="true"></script>
}
