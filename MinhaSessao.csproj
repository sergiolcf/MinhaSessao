<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6143e142-a2ea-4997-ae6e-81476fc4c1dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
  </ItemGroup>

  <!-- MinhaSessao.Tests fica aninhado dentro desta pasta; sem isso o glob padrão do SDK Web
       tentaria compilar os arquivos do projeto de testes dentro do próprio MinhaSessao.csproj -->
  <ItemGroup>
    <Compile Remove="MinhaSessao.Tests/**/*.cs" />
    <Content Remove="MinhaSessao.Tests/**/*" />
    <None Remove="MinhaSessao.Tests/**/*" />
  </ItemGroup>

</Project>
